DATABASE_URL=postgresql://spectra:spectra@localhost:5432/spectra
DBOS__VMID=spectra-artifacts-local
WORKER_HEALTH_PORT=8787
REDIS_URL=redis://localhost:6379
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_SIGN_UP_ENABLED=true
EMAIL_FROM=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
STORAGE_ENDPOINT=http://localhost:7070
STORAGE_REGION=us-east-1
STORAGE_BUCKET=spectra-dev
STORAGE_ACCESS_KEY_ID=spectra-local
STORAGE_SECRET_ACCESS_KEY=spectra-local-only
STORAGE_FORCE_PATH_STYLE=true
# Internal production bootstrap only; permits the bucket initializer to reach the Compose service.
STORAGE_SETUP_ALLOW_INTERNAL_ENDPOINT=false
MINERU_API_TOKEN=
# Docker Compose only. CI replaces this versioned tag with the published digest.
SPECTRA_STRATUMIND_IMAGE=ghcr.io/ln-one/stratumind:api-v1.1.7
STRATUMIND_URL=http://127.0.0.1:6333
STRATUMIND_API_KEY=
STRATUMIND_COLLECTION=spectra-knowledge-v1-512
KNOWLEDGE_INDEXING_ENABLED=false
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v4
KNOWLEDGE_EMBEDDING_DIMENSION=512
KNOWLEDGE_RERANK_MODEL=qwen3-rerank
KNOWLEDGE_RERANK_TIMEOUT_MS=12000
SPECTRA_VISUAL_DESCRIPTION_MODEL_ID=qwen3.7-plus

# Versioned prebuilt Deckelier entrypoint. HTTPS is required outside loopback development.
NEXT_PUBLIC_DECKELIER_URL=/deckelier/index.html

# Opt-in durable artifact authoring through an OpenHands Agent Server.
# Development: one loopback Agent Server. Do not set together with the template below.
OPENHANDS_EXECUTION_ENABLED=false
OPENHANDS_RUNTIME_URL=http://127.0.0.1:8000
# The single-node Compose profile pins this public image by digest. The current
# release is amd64; Docker Desktop can emulate it on Apple Silicon.
OPENHANDS_RUNTIME_IMAGE=ghcr.io/ln-one/spectra-agent-runtime@sha256:62a919a1b8380c524dbb9fc7e082e202a4943d4303e45414c9510aed00fdc7dc
OPENHANDS_RUNTIME_PLATFORM=linux/amd64
# Production: an external provisioner/router must resolve each stable attempt ID to its own
# isolated Agent Server. Exactly one {attemptId} token is required.
OPENHANDS_RUNTIME_URL_TEMPLATE=
OPENHANDS_RUNTIME_API_KEY=
# Compose-only secret used to encrypt the Runtime's persisted Agent Server state.
OPENHANDS_SECRET_KEY=
UNSPLASH_ACCESS_KEY=
# Optional attempt-scoped links for the development diagnostics page.
OPENHANDS_WORKSPACE_URL_TEMPLATE=
OPENHANDS_VSCODE_URL_TEMPLATE=
OPENHANDS_VNC_URL_TEMPLATE=
OPENHANDS_LLM_API_KEY=
OPENHANDS_LLM_BASE_URL=
# Model identifier exposed by the external OpenAI-compatible endpoint.
OPENHANDS_LLM_MODEL=openai/spectra-authoring
OPENHANDS_CONDENSER_MAX_EVENTS=80
OPENHANDS_CONDENSER_MAX_TOKENS=200000
OPENHANDS_CONDENSER_MAX_OUTPUT_TOKENS=4096
OPENHANDS_LLM_ENABLE_THINKING=true
OPENHANDS_LLM_REASONING_EFFORT=medium
OPENHANDS_LLM_TIMEOUT_SECONDS=900
OPENHANDS_AGENT_MAX_ITERATIONS=200
OPENHANDS_POLL_INTERVAL_MS=15000
PRESENTATION_ATTEMPT_TIMEOUT_MS=2100000
PRESENTATION_COLLECTION_RESERVE_MS=300000
PRESENTATION_AGENT_MAX_ACCUMULATED_TOKENS=12000000
PRESENTATION_MAX_FAILED_VISUAL_CHECKS=8
PRESENTATION_MAX_STALLED_VISUAL_CHECKS=3
ANIMATION_ATTEMPT_TIMEOUT_MS=2700000
ANIMATION_EXECUTION_ENABLED=false
PRESENTATION_PUBLISHED=false
ANIMATION_PUBLISHED=false
REMOTION_BROWSER_EXECUTABLE=
ANIMATION_RENDER_TIMEOUT_MS=1200000
ANIMATION_RENDER_CONCURRENCY=1
# Bubblewrap isolates the renderer process when explicitly configured.
ANIMATION_RENDER_SANDBOX_EXECUTABLE=
OPENHANDS_WORKSPACE_ROOT=/workspace/spectra

# Explicit opt-in Knowledge Search acceptance lab. Defaults use its isolated Compose project.
KNOWLEDGE_ACCEPTANCE_POSTGRES_URL=postgresql://spectra:spectra@127.0.0.1:55432/postgres
KNOWLEDGE_ACCEPTANCE_STRATUMIND_URL=http://127.0.0.1:6433
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
LOG_LEVEL=info
MASTRA_OBSERVABILITY_DATABASE_URL=
# Leave unset to disable application tracing. Local Alloy accepts OTLP HTTP on this endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1
