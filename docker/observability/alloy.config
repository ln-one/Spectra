local.file_match "spectra_development" {
	path_targets = [
		{
			"__path__"    = "/var/log/spectra/*.log",
			"environment" = "development",
			"job"         = "spectra-development",
		},
	]
	sync_period = "2s"
}

loki.source.file "spectra_development" {
	targets       = local.file_match.spectra_development.targets
	forward_to    = [loki.process.spectra_development.receiver]
	tail_from_end = false
}

loki.process "spectra_development" {
	stage.json {
		drop_malformed = true
		expressions    = {
			attemptId      = "attemptId",
			artifactId     = "artifactId",
			component      = "component",
			conversationId = "conversationId",
			durationMs     = "durationMs",
			event          = "event",
			failureCode    = "failureCode",
			ingestionId    = "ingestionId",
			level          = "level",
			renderJobId    = "renderJobId",
			retryable      = "retryable",
			runId          = "runId",
			service        = "service",
			span_id        = "span_id",
			stage          = "stage",
			time           = "time",
			trace_flags    = "trace_flags",
			trace_id       = "trace_id",
			workflowId     = "workflowId",
			workspaceId    = "workspaceId",
		}
	}

	stage.drop {
		source              = "service"
		expression          = "^$"
		drop_counter_reason = "missing_service"
	}

	stage.timestamp {
		source = "time"
		format = "RFC3339Nano"
	}

	stage.labels {
		values = {
			service = "",
		}
	}

	stage.structured_metadata {
		values = {
			attemptId      = "",
			artifactId     = "",
			component      = "",
			conversationId = "",
			durationMs     = "",
			event          = "",
			failureCode    = "",
			ingestionId    = "",
			level          = "",
			renderJobId    = "",
			retryable      = "",
			runId          = "",
			span_id        = "",
			stage          = "",
			trace_flags    = "",
			trace_id       = "",
			workflowId     = "",
			workspaceId    = "",
		}
	}

	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

otelcol.receiver.otlp "local" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.processor.batch.traces.input]
	}
}

otelcol.processor.batch "traces" {
	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		tls {
			insecure = true
		}
	}
}
