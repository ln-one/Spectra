FROM node:24.17.0-bookworm-slim@sha256:862263c612aa437e3037674b85419622a9d93bff80aa1eee5398dfe686375532 AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
ARG http_proxy
ARG https_proxy
RUN http_proxy="$http_proxy" https_proxy="$https_proxy" \
    npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY . .

FROM node:24.17.0-bookworm-slim@sha256:862263c612aa437e3037674b85419622a9d93bff80aa1eee5398dfe686375532

WORKDIR /app
COPY scripts/install-pandoc.sh /tmp/install-pandoc.sh
ARG http_proxy
ARG https_proxy
RUN http_proxy="$http_proxy" https_proxy="$https_proxy" \
    apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install --yes --no-install-recommends chromium ffmpeg ca-certificates curl \
    && bash /tmp/install-pandoc.sh /usr/local \
    && rm /tmp/install-pandoc.sh \
    && rm -rf /var/lib/apt/lists/*
COPY --from=dependencies --chown=node:node /app /app

ENV NODE_ENV=production
ENV REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
ENV ANIMATION_RENDER_CONCURRENCY=1
ENV ANIMATION_RENDER_TIMEOUT_MS=1200000
EXPOSE 8787

USER node
CMD ["npm", "run", "worker:dbos"]
