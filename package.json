{
  "name": "spectra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "agent:observability:prune": "node --conditions=react-server --import tsx scripts/prune-mastra-observability.ts",
    "auth:migrate": "auth migrate --config src/features/auth/server.ts --yes",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "dbos:setup": "node --conditions=react-server --import tsx scripts/setup-dbos.ts",
    "dbos:doctor": "node --conditions=react-server --import tsx scripts/dbos-doctor.ts",
    "worker:dbos": "node --conditions=react-server --import tsx src/worker/dbos.ts",
    "storage:setup": "node scripts/setup-local-storage.mjs",
    "dev": "npm run db:migrate && npm run auth:migrate && npm run dbos:setup && node scripts/run-observed-development.mjs",
    "dev:processes": "concurrently --raw --kill-others \"npm:dev:web\" \"npm:worker:dbos:dev\"",
    "dev:web": "next dev",
    "worker:dbos:dev": "nodemon --watch src --ext ts,tsx --signal SIGTERM --exitcrash --exec \"node --conditions=react-server --import tsx src/worker/dbos.ts\"",
    "build": "next build",
    "check": "biome check .",
    "check:architecture": "depcruise src",
    "check:dead-code": "knip",
    "check:staged": "biome check --staged --no-errors-on-unmatched",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "start": "next start",
    "test": "vitest run",
    "test:agent:live": "node --conditions=react-server --import tsx scripts/test-agent-mastra-live.ts",
    "eval:agent:offline": "node --conditions=react-server --import tsx scripts/agent-evals/offline.ts",
    "eval:agent:live": "node --conditions=react-server --import tsx scripts/agent-evals/live.ts",
    "test:artifact-stream:live": "node --conditions=react-server --import tsx scripts/test-artifact-stream-live.ts",
    "test:artifact:dbos-long": "ARTIFACT_DBOS_LONG_SMOKE=1 vitest run src/features/artifacts/documents/dbos-recovery.system.database.test.ts",
    "test:media:live": "node --conditions=react-server --import tsx scripts/test-media-understanding-live.ts",
    "test:mineru": "node --conditions=react-server --import tsx scripts/test-mineru-contract.ts",
    "test:storage": "vitest run --config tests/storage/vitest.config.ts",
    "test:web-search:live": "node --conditions=react-server --import tsx scripts/test-web-search-live.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "node scripts/run-playwright.mjs",
    "verify": "npm run typecheck && npm run check && npm run check:architecture && npm run check:dead-code && npm test && npm run eval:agent:offline && npm run db:check",
    "verify:browser": "node scripts/run-playwright.mjs --build",
    "verify:changed": "node --import tsx scripts/verify-changed.ts",
    "verify:full": "npm run verify && npm run verify:browser",
    "prepare": "simple-git-hooks",
    "knowledge:acceptance:infra:down": "docker compose --project-name spectra-knowledge-acceptance --file compose.knowledge-acceptance.yaml down --volumes --remove-orphans",
    "knowledge:acceptance:infra:up": "docker compose --project-name spectra-knowledge-acceptance --file compose.knowledge-acceptance.yaml up --detach --wait",
    "knowledge:acceptance:live": "node --conditions=react-server --import tsx scripts/knowledge-acceptance/cli.ts --mode live",
    "knowledge:acceptance:offline": "node --conditions=react-server --import tsx scripts/knowledge-acceptance/cli.ts --mode offline",
    "knowledge:formats:native": "node --conditions=react-server --import tsx scripts/knowledge-format-acceptance/native.ts",
    "knowledge:formats:media:offline": "node --conditions=react-server --import tsx scripts/knowledge-format-acceptance/media.ts --mode=offline",
    "knowledge:formats:media:live": "node --conditions=react-server --import tsx scripts/knowledge-format-acceptance/media.ts --mode=live",
    "observability:doctor": "node scripts/observability.mjs doctor",
    "observability:down": "node scripts/observability.mjs down",
    "observability:up": "node scripts/observability.mjs up",
    "openhands:runtime:doctor": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/doctor-task-agent-runtime.ts",
    "openhands:test:animation:live": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/test-task-agent-runtime-live.ts --kind=animation --runs=3",
    "openhands:test:presentation:live": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/test-task-agent-runtime-live.ts --kind=presentation --runs=3",
    "test:knowledge:live": "node --conditions=react-server --import tsx scripts/test-knowledge-live.ts",
    "test:knowledge-citation-agent:live": "node --conditions=react-server --import tsx scripts/test-knowledge-citation-agent-live.ts",
    "test:knowledge-visual:live": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/verify-workspace-visual-response.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check:staged"
  },
  "overrides": {
    "@ai-sdk/react": "3.0.230",
    "ai": "6.0.228",
    "lodash": "4.18.1"
  },
