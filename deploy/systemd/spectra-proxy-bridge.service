[Unit]
Description=Spectra Docker network proxy bridge
After=docker.service mihomo.service
Wants=docker.service mihomo.service

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:17890,bind=172.17.0.1,reuseaddr,fork TCP:127.0.0.1:7890
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
